{
  "name": "collecto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:list": "node --env-file-if-exists=.env scripts/migrate.mjs list",
    "db:push": "node --env-file-if-exists=.env scripts/migrate.mjs push",
    "app:dev": "npm run dev -w app",
    "app:build": "npm run build -w app",
    "app:test": "npm run test:rust -w app"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    }
  }
}
