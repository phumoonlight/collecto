# Three Postgres logins, because they are three different powers. db/README.md creates
# the two that are yours. A separate Neon project from booru's — nothing here is shared.

# The website's, and the only one Vercel ever gets. Reads the two tables and writes exactly
# one column — the view counter — and the database enforces that, not the code.
DATABASE_URL=postgresql://collecto_web:YOUR_PASSWORD@YOUR_POOLED_HOST/app?sslmode=require

# The app's. Packed with the six values below into the app's setup code by
# `npm run app:code` — the app itself is built without any of them. Reads and writes every
# row; may not create, alter or drop anything. Never deployed to the website.
DATABASE_URL_APP=postgresql://collecto_app:YOUR_PASSWORD@YOUR_HOST/app?sslmode=require

# The migration runner's, and nothing else's — `npm run db:push`. Owns the tables. On Neon
# this is the role the project came with (`neondb_owner`).
DATABASE_URL_OWNER=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/app?sslmode=require

# Where images are served from — the R2 bucket's public origin, no trailing slash. Public by
# definition: it is in the markup of every page.
NEXT_PUBLIC_CDN_URL=https://img.collecto.example.com

# Optional: the passphrase `npm run app:code` encrypts the setup code with. Empty asks for it
# (hidden), with Enter generating one. Setting it here keeps the code and its passphrase in one
# file — fine on your own machine, but never commit or share it.
APP_CODE_GEN_PASSPHRASE=

# Writing to that bucket. Only the app's setup code carries these; the website has none.
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=collecto

# Public origin, for canonical URLs, OpenGraph, robots.txt and sitemap.xml. The website can
# go without it (Vercel supplies a deployment URL); the app needs it to open a shelf on the site.
NEXT_PUBLIC_SITE_URL=https://collecto.example.com

# What the site is called: the wordmark, the tab title, every OpenGraph card.
NEXT_PUBLIC_SITE_NAME=Collecto
