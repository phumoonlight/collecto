{
  "name": "app",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Collecto's manager — a Tauri app with a Rust backend: collections, uploads with lossless compression, caching and logs",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8"
  }
}
