{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // What the website and the app's window both compile — a directory of this repo, not
      // an installed package: no build step, resolved through this mapping like `@/`.
      "@common/*": ["./packages/common/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // packages/app is its own program (a Vite window, its own tsconfig) and type-checks with
  // `npm run typecheck -w app`. packages/common is in here: the web compiles it.
  "exclude": ["node_modules", "packages/app"]
}
